PORT=8000
MONGO_URI=mongodb://127.0.0.1:27017/job-portal
SECRET_KEY=replace-with-a-long-random-secret
CLOUD_NAME=your-cloudinary-cloud-name
API_KEY=your-cloudinary-api-key
API_SECRET=your-cloudinary-api-secret

# Optional semantic matching. Without this key the portal still works and
# available keyword/evidence criteria are scored with an explicit partial-analysis label.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
